# ==============================================================================
# AI Musical Therapy Platform — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
APP_NAME=AI Musical Therapy Platform
APP_ENV=development                    # development | staging | production
APP_DEBUG=true
APP_PORT=8000
APP_HOST=0.0.0.0
APP_VERSION=0.1.0
APP_SECRET_KEY=your-secret-key-here    # Generate: openssl rand -hex 32
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_musical_therapy
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_SSL_MODE=disable                     # disable | require | verify-full
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ------------------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ------------------------------------------------------------------------------
# Authentication
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=your-jwt-secret-key      # Generate: openssl rand -hex 64
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# OAuth — Google
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ------------------------------------------------------------------------------
# Spotify Integration
# ------------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=your-spotify-client-id        # Register at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIPY_CLIENT_ID=your-spotify-client-id        # Also required by spotipy library (same value)
SPOTIPY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/spotify/callback

# ------------------------------------------------------------------------------
# AI/ML — HuggingFace + DeepFace (foundation model pipeline)
# ------------------------------------------------------------------------------
MOCK_ML=false                                   # Set "true" to skip real ML (CI/dev mode)
ML_MODEL_PATH=./ml/models
ML_DEVICE=cpu                                   # cpu | cuda | mps
ML_BATCH_SIZE=32
ML_CONFIDENCE_THRESHOLD=0.5
# Optional: custom PyTorch weights download URL (Option A pipeline)
MODEL_WEIGHTS_URL=https://huggingface.co/your-org/ai-musical-therapy-face-emotion/resolve/main/best_model.pth
MODEL_WEIGHTS_CHECKSUM=                         # SHA-256 of best_model.pth (fill after training)

# ------------------------------------------------------------------------------
# NVIDIA NIM — Nemotron-3-Nano-Omni (Emotion Detection: Face / Audio / Text)
# ------------------------------------------------------------------------------
# Get a free API key at: https://build.nvidia.com → "Generate API Key"
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# ------------------------------------------------------------------------------
# OpenAI / LLM (for AI Therapy Assistant)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7

# ------------------------------------------------------------------------------
# File Storage
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,wav,mp3,webm

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                         # json | text
LOG_FILE=./logs/app.log

# ------------------------------------------------------------------------------
# Monitoring
# ------------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ------------------------------------------------------------------------------
# Email (for notifications)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@aimusicaltherapy.com

# ------------------------------------------------------------------------------
# MLflow (Experiment Tracking)
# ------------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=emotion-detection

# ------------------------------------------------------------------------------
# Docker
# ------------------------------------------------------------------------------
DOCKER_REGISTRY=ghcr.io/ai-musical-therapy
DOCKER_TAG=latest
